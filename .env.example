# Server-only. Never prefix these values with NEXT_PUBLIC_.
# PocketBase base URL (private network address in production).
POCKETBASE_URL=http://127.0.0.1:8090

# Canonical public origin of this app. Used for the exact-origin check on cookie-authenticated
# mutations and to decide cookie security (https -> Secure `__Host-session` cookie).
APP_ORIGIN=http://localhost:3000

# Optional: header carrying the real client IP set by your reverse proxy (e.g. cf-connecting-ip).
# Unset = rightmost X-Forwarded-For hop. Used for rate limiting and forwarded to PocketBase.
# CLIENT_IP_HEADER=

# Public, build-time values.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Set to true only for a reviewed public launch (robots, sitemap, indexing).
NEXT_PUBLIC_INDEXABLE=false
